  },
  {
    "start": 519.3199999999999,
    "end": 522.3199999999999,
    "text": "کر کے, kithni hoge 25, to woa, ki value di kha de kha de kha."
  },
  {
    "start": 522.3199999999999,
    "end": 528.4399999999999,
    "text": "Feroose ke baad haga ji, aapka haose ke baad ha, next, df.d types ki aapka data"
  },
  {
    "start": 528.4399999999999,
    "end": 533.3,
    "text": "joa wo kis type ka, student ID, int type ki name ek object, jo corrector values"
  },
  {
    "start": 533.3,
    "end": 537.18,
    "text": "ko ek object ki tara le te hai, aur age joa wo int type ka, to int de kha de ha di ha,"
  },
  {
    "start": 537.18,
    "end": 542.78,
    "text": "60 formala, bid for day, 64 bit mi store kar rai sko, the ke na 8 bid ka le ke chal rai"
  },
  {
    "start": 542.78,
    "end": 547.6999999999999,
    "text": "to ko i baat ni system keu pa dipend kar tain, ism keu i faal to meolojne wali baat ni"
  },
  {
    "start": 547.6999999999999,
    "end": 552.5,
    "text": "hai, the ke, feroa ga ji, df.values, to saari value, jo tabanar values amne dali hai"
  },
  {
    "start": 552.5,
    "end": 557.02,
    "text": "wo table ki values ko ishari ke se, koma separated me show kar de ka, jo menne table ki values"
  },
  {
    "start": 557.02,
    "end": 562.0799999999999,
    "text": "load ki hai, usko ishari ke se list ke form me stod kar de ka, the ke, menu show kar de ka"
  },
  {
    "start": 562.0799999999999,
    "end": 567.5799999999999,
    "text": "se rafi ye show kar rai, actual data meis mein kui chage ni ho ra, df.index, abha"
  },
  {
    "start": 567.58,
    "end": 572.5,
    "text": "ko index di kha de ha, ki meera starting index zero hai, start jo last table five hai,"
  },
  {
    "start": 572.5,
    "end": 577.26,
    "text": "jo eros hai, zero se le ke 1, 2, 3, 4, 5, ta ki sri ke se, ros hai, aur step"
