    "text": "دیتا ایٹیکس کی بات کرتے ہیں"
  },
  {
    "start": 12.5,
    "end": 14.3,
    "text": "تو ہم لوگ چاہتے ہیں کہ ہمارے پس کوئی"
  },
  {
    "start": 14.3,
    "end": 16.7,
    "text": "ایسا دیتا سٹکچ رو جو دیتا کو"
  },
  {
    "start": 16.7,
    "end": 18.5,
    "text": "تبلر فوم میں سٹور کرسکے"
  },
  {
    "start": 18.5,
    "end": 19.7,
    "text": "جیسے دیتا بیس میں ہوتا ہے"
  },
  {
    "start": 19.7,
    "end": 21.400000000000002,
    "text": "روز اور کالمز کی فوم میں کی"
  },
  {
