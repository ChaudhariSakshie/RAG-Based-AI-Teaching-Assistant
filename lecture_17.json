  },
  {
    "start": 30.4,
    "end": 32.4,
    "text": "تو یہاں پہ ہم لوگ ہمارے بیس کرتے ہیں"
  },
  {
    "start": 32.4,
    "end": 33.9,
    "text": "دیتا فریمز کو"
